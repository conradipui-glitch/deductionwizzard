  "hypotheses": [
    {
      "id": "h-idalia",
      "statement": "Идалия организовала пасквиль из ревности к Наталье.",
      "assumptions": [
        "До рассылки у Идалии был соответствующий мотив",
        "Идалия имела доступ к необходимым сведениям и адресатам"
      ],
      "discriminating_test": "Найти до ноября 1836 года независимое свидетельство об участии Идалии в составлении или рассылке; сравнить с адресной сетью."
    },
    {
      "id": "h-heckern",
      "statement": "Луи Геккерн участвовал в подготовке или распространении анонимного письма.",
      "assumptions": [
        "Личные обвинения Пушкина могут быть ошибочными"
      ],
      "discriminating_test": "Установить независимое от обвинения Пушкина свидетельство подготовки, передачи или рассылки письма Геккерном."
    },
    {
      "id": "h-court",
      "statement": "Пасквиль был частью согласованной политической операции против Пушкина или Николая I.",
      "assumptions": [
        "У предполагаемых участников была общая политическая цель",
        "Имелась координация до ноября 1836 года"
      ],
      "discriminating_test": "Найти современный событиям документ, связывающий отправителей и согласованную политическую цель; отличить от салонных слухов."
    }
  ],
