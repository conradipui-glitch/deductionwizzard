{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/historic-deduction-sim/casebook.schema.json",
  "title": "Historic Deduction Sim casebook v1",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "title",
    "entities",
    "sources",
    "claims",
    "events",
    "relations",
    "hypotheses",
    "assessments"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assessment"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "datepoint": {
      "type": "object",
      "required": [
        "year"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "not": {
            "const": 0
          }
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "title",
        "type",
        "locator",
        "derived_from"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "primary",
            "secondary",
            "tertiary"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "created": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "year"
              ],
              "properties": {
                "year": {
                  "type": "integer",
                  "not": {
                    "const": 0
                  }
                },
                "month": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "day": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 31
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "text",
        "kind",
        "status",
        "about",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "event_report",
            "attribution",
            "interpretation",
            "identity_proposal"
          ]
        },
        "status": {
          "enum": [
            "attested",
            "contested",
            "unverified"
          ]
        },
        "about": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "stance",
              "locator"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "stance": {
                "enum": [
                  "supports",
                  "contradicts"
                ]
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "time": {
      "type": "object",
      "required": [
        "original",
        "normalization",
        "precision",
        "earliest",
        "latest"
      ],
      "properties": {
        "original": {
          "type": "string",
          "minLength": 1
        },
        "normalization": {
          "type": "string",
          "minLength": 1
        },
        "precision": {
          "enum": [
            "day",
            "month",
            "year",
            "range",
            "approximate",
            "unknown"
          ]
        },
        "earliest": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "year"
              ],
              "properties": {
                "year": {
                  "type": "integer",
                  "not": {
                    "const": 0
                  }
                },
                "month": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "day": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 31
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "latest": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "year"
              ],
              "properties": {
                "year": {
                  "type": "integer",
                  "not": {
                    "const": 0
                  }
                },
                "month": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "day": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 31
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "title",
        "time",
        "actors",
        "claim_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "original",
                "normalization",
                "precision",
                "earliest",
                "latest"
              ],
              "properties": {
                "original": {
                  "type": "string",
                  "minLength": 1
                },
                "normalization": {
                  "type": "string",
                  "minLength": 1
                },
                "precision": {
                  "enum": [
                    "day",
                    "month",
                    "year",
                    "range",
                    "approximate",
                    "unknown"
                  ]
                },
                "earliest": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": [
                        "year"
                      ],
                      "properties": {
                        "year": {
                          "type": "integer",
                          "not": {
                            "const": 0
                          }
                        },
                        "month": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 12
                        },
                        "day": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 31
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "latest": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": [
                        "year"
                      ],
                      "properties": {
                        "year": {
                          "type": "integer",
                          "not": {
                            "const": 0
                          }
                        },
                        "month": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 12
                        },
                        "day": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 31
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "person",
            "group",
            "institution",
            "place",
            "culture",
            "deity",
            "text",
            "concept",
            "other"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": [
        "id",
        "from_id",
        "to_id",
        "type",
        "claim_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from_id": {
          "type": "string",
          "minLength": 1
        },
        "to_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "hypothesis": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "assumptions",
        "discriminating_test"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "discriminating_test": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "required": [
        "id",
        "hypothesis_id",
        "claim_id",
        "stance",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "hypothesis_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "stance": {
          "enum": [
            "supports",
            "contradicts",
            "compatible",
            "unknown"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
